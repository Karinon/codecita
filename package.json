{
  "name": "codecita",
  "version": "0.1.3",
  "description": "Zarrita-compatible codec implementations",
  "author": "Andrej Fast",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./blosc2": {
      "types": "./dist/blosc2.d.ts",
      "default": "./dist/blosc2.js"
    },
    "./fletcher32": {
      "types": "./dist/fletcher32.d.ts",
      "default": "./dist/fletcher32.js"
    },
    "./gribscan": {
      "types": "./dist/gribscan.d.ts",
      "default": "./dist/gribscan.js"
    },
    "./logBins": {
      "types": "./dist/logBins.d.ts",
      "default": "./dist/logBins.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Karinon/codecita.git"
  },
  "keywords": [
    "zarr",
    "compression",
    "codecs",
    "storage"
  ],
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "prepare": "(husky || true) && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "lint-ci": "eslint src tests --max-warnings 0",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.md": [
      "prettier --write"
    ],
    "!(*package-lock).json": [
      "prettier --write"
    ]
  },
  "peerDependencies": {
    "zarrita": "^0.7.5"
  },
  "peerDependenciesMeta": {
    "zarrita": {
      "optional": true
    }
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "~24",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^7.3.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9",
    "zarrita": "^0.7.5"
  },
  "engines": {
    "node": ">=24.16.0"
  }
}
